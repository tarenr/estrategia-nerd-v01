{
  "name": "estrategia-nerd/app",
  "description": "Estrategia Nerd - Portal de tecnologia, games e cultura pop",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "phpstan": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=512M"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}

# -----------------------------------------------------------------------------
# @file        public/.htaccess
# @project     Estrategia Nerd
# @purpose     Reescrita de URLs para front controller
# @notes       Requer mod_rewrite + AllowOverride All
# -----------------------------------------------------------------------------

Options -Indexes
RewriteEngine On

# Base do projeto dentro do htdocs
RewriteBase /estrategia-nerd/public/

# Se o arquivo/pasta existir, não reescreve
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tudo vai para o front controller
RewriteRule ^ index.php [L]
DirectoryIndex index.php
# -----------------------------------------------------------------------------
# @file        public/.htaccess
# @project     Estrategia Nerd
# @purpose     Reescrita de URLs para front controller
# @notes       Funciona tanto no XAMPP local quanto na producao em raiz publica.
# -----------------------------------------------------------------------------

Options -Indexes
RewriteEngine On

# Bloqueio de rotas administrativas e login exclusivamente em producao e stage
RewriteCond %{HTTP_HOST} (^|\.)estrategianerd\.com\.br$ [NC]
RewriteRule ^(admin|login|logout)(/|$) - [R=404,L]

# Se o arquivo/pasta existir, nao reescreve
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tudo vai para o front controller
RewriteRule ^ index.php [L]
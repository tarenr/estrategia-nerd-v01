DirectoryIndex public/index.php

# -----------------------------------------------------------------------------
# @file        .htaccess
# @project     Estrategia Nerd
# @purpose     URLs amigaveis no XAMPP local sem expor /public na barra.
# @notes       Mantem o front controller real em public/index.php.
# -----------------------------------------------------------------------------

Options -Indexes
RewriteEngine On

# Nunca expor pastas e arquivos tecnicos pela raiz local.
RewriteRule ^(?:app|config|docs|scripts|storage|vendor)(/|$) - [F,L]
RewriteRule ^(?:bootstrap\.php|composer\.(json|lock)|package(?:-lock)?\.json|\.env.*|README.*)$ - [F,L]

# Compatibilidade com URLs antigas que ainda apontam para /public.
RewriteRule ^public/ - [L]

# Assets e uploads continuam servidos pela pasta publica.
RewriteRule ^(assets|uploads)/(.*)$ public/$1/$2 [L]
RewriteRule ^(favicon\.ico|robots\.txt|sitemap\.xml)$ public/$1 [L]

# Todas as rotas da aplicacao entram pelo front controller publico.
RewriteRule ^ public/index.php [L]
